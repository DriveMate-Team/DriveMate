    <path
        android:fillColor="#FFC107"
        android:pathData="M54,21L80,32L54,43L28,32Z" />
    <!-- 모자 술 -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFC107"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:pathData="M78,33L78,45" />
    <path
        android:fillColor="#FFC107"
