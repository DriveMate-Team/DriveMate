<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />

    <!-- [1단계] 차량 속도를 읽는 권한 (AAOS 표준). 실행 중 허용 팝업이 뜰 수 있음 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- [1단계] 기어(P/R/N/D)를 읽는 권한 (AAOS 표준). 일반 앱에는 거부될 수 있음 -> 화면에 오류로 표시됨 -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- [1단계] 조향각을 읽는 Pleos 권한. 조향각 전용 권한이 문서에 없어서 CAR_DRIVE로 "추정"한 것. 오류가 나면 바꿔야 함 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- [출발 인사] 안전벨트 상태(미착용 경고)를 읽는 Pleos 권한 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <!-- [출발 인사] 안전벨트 "착용 상태"를 읽는 Pleos 권한 (미착용 경고가 지원되지 않는 차종을 위한 2차 시도) -->
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />

    <!-- [2단계] TextToSpeech(음성 안내) SDK 사용 권한. 없으면 초기화/말하기가 실패한다 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <application>
        <!-- [6단계 실험] Gleo AI가 우리 앱 함수를 호출할 때 받는 수신기 (schema.json의 함수 이름과 같은 action) -->
        <receiver
            android:name="com.example.drivemate.shared.GleoActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="GET_DRIVING_STATUS" />
                <action android:name="GET_TRIP_DISTANCE" />
                <action android:name="GET_GRADUATION_PROGRESS" />
            </intent-filter>
        </receiver>

        <!--
          DriveMate 화면: 템플릿 없이 직접 그린다. 앱 실행 아이콘의 진입점.
          singleTask: 다시 열어도 같은 화면을 재사용. configChanges: 주야간/화면 크기가 바뀌어도 Activity를 다시 만들지 않는다(주행 기록 유지).
          distractionOptimized: 운전 중에도 표시되는 화면임을 선언(운전 중에는 터치할 곳이 없다).
        -->
        <activity
            android:name="com.example.drivemate.shared.DriveMateActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DriveMate.Ui"
            android:configChanges="uiMode|orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden"
            android:label="@string/drivemate_app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>