<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 차량 속도를 읽는 권한 (AAOS 표준). 처음 실행할 때 허용 팝업이 뜬다 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!-- 기어(P/R/N/D)를 읽는 권한 (AAOS 표준) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- 브레이크 페달 상태를 읽는 Pleos 권한 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 방향지시등 상태를 읽는 Pleos 권한 -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <!-- 내비의 목적지·다음 회전을 읽는 Pleos 권한 (NaviHelper SDK) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- 음성 안내(TextToSpeech SDK) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <!-- 음성 질문 인식(SpeechToText SDK) -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- 마이크: 운전자의 질문을 듣는 데만 쓴다 (녹음 파일은 저장하지 않는다) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 위치: 급가속·급감속이 생긴 곳을 기기 안에만 기록한다 (거부해도 앱은 동작한다) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".DriveMateApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DriveMate">

        <!-- 이 앱이 Android Automotive OS(차량)용임을 알린다 -->
        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <!--
          DriveMate의 유일한 Activity. 5개 화면(홈·준비·주행 중·리포트·기록)은 이 안에서 Compose로 바뀐다.
          singleTask: 다시 열어도 같은 화면을 재사용.
          configChanges: 주야간 모드/창 크기가 바뀌어도 Activity를 다시 만들지 않는다 (Compose가 알아서 다시 그림).
          screenOrientation을 지정하지 않음: Pleos 가이드대로 가로·세로 창 모두 대응.
          distractionOptimized: 주행 중에도 표시되는 화면임을 선언 (주행 중 화면은 버튼 2개와 한 줄 안내만 있다).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="uiMode|orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>
